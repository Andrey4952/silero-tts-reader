[Desktop Entry]
Name=Silero TTS Reader
GenericName=Text to Speech Reader
Comment=Read selected text aloud using Silero TTS
Exec=silero-tts-reader
Icon=audio-headset
Terminal=false
Type=Application
Categories=Accessibility;Utility;
Keywords=tts;text;speech;silero;read;
StartupNotify=false
X-GNOME-Autostart-enabled=true
